import { defineConfig } from 'vitepress'
import fs from 'fs'
import path from 'path'

// Read sidebar generated by script if present
let sidebar = []
try {
  const sidebarPath = path.resolve(__dirname, 'sidebar.json')
  if (fs.existsSync(sidebarPath)) {
    sidebar = JSON.parse(fs.readFileSync(sidebarPath, 'utf-8'))
  }
} catch (e) {
  sidebar = []
}

